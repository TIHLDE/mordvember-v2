# Postgres (Neon i produksjon, lokal Postgres i utvikling)
DATABASE_URL=postgres://mordvember:mordvember@localhost:5432/mordvember

# Photon OIDC
PHOTON_ISSUER=https://photon.tihlde.org/api/auth
PHOTON_CLIENT_ID=
PHOTON_CLIENT_SECRET=

# Photon e-post-API (POST /api/email/send, Bearer-nøkkel)
PHOTON_EMAIL_API_KEY=
EMAIL_FROM=no-reply@tihlde.org

# Hemmelighet for QR-koder (lang, tilfeldig streng)
QR_SECRET=

# Vercel Blob (privat lager): token, eller BLOB_STORE_ID med OIDC på Vercel. Uten begge lagres bilder på disk i utvikling.
BLOB_READ_WRITE_TOKEN=

# Brukernavn (kommaseparert) som alltid er spillmester, også før første sesong finnes
SUPERADMINS=

# Kreves i produksjon. Vercel sender verdien som Bearer-token til Nitro cron-endepunktet.
CRON_SECRET=

# Offentlig adresse, brukes i lenker i e-post og QR-koder
APP_URL=http://localhost:3000
