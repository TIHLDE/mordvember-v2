{
  "name": "mordvember",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test:e2e": "tsx tests/e2e/walkthrough.ts",
    "test:leak": "tsx tests/e2e/leak-check.ts",
    "test:photon": "tsx tests/e2e/photon-login.ts",
    "photon:mock": "tsx tests/e2e/photon-mock.ts",
    "build:vercel": "tsx scripts/vercel-build.ts && next build",
    "fallow": "fallow"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@vercel/blob": "^2.8.1",
    "@vitejs/plugin-react": "^6.2.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "next": "^16.4.0",
    "nitro": "3.0.261103-rc",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "fallow": "^3.35.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
